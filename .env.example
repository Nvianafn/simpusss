# SIMPUS local development example
# Copy to .env only if you need root-level variable substitution.
# Do not commit real production secrets.

MYSQL_ROOT_PASSWORD=change-me-local-root-password
INTERNAL_API_TOKEN=change-me-internal-token

# Browser/host access
AUTH_SERVICE_URL=http://localhost:8000
MAHASISWA_SERVICE_URL=http://localhost:8001
PPL_SERVICE_URL=http://localhost:8002
KLINIK_SERVICE_URL=http://localhost:8003
BANK_SERVICE_URL=http://localhost:8004
FRONTEND_URL=http://localhost:8080

# Laravel cache driver/store used by backend containers
CACHE_STORE=file
