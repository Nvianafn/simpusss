APP_NAME=mahasiswa-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mahasiswa-db
DB_PORT=3306
DB_DATABASE=mahasiswa_db
