# SIMPUS monorepo - Laravel multi-service + Vite frontend
# Keep source/config templates tracked, keep secrets/build/cache/deps out of Git.

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.vps.example

# Local credentials / keys / certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
*.mobileprovision
*.token

# -----------------------------------------------------------------------------
# PHP / Composer dependencies
# -----------------------------------------------------------------------------
vendor/
**/vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/

# -----------------------------------------------------------------------------
# Node / Vite dependencies and builds
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Vite/Laravel build outputs
public/build/
**/public/build/
.hot
**/.hot

# -----------------------------------------------------------------------------
# Laravel generated/cache/runtime files
# -----------------------------------------------------------------------------
storage/logs/*.log
**/storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/testing/*
**/storage/framework/views/*
bootstrap/cache/*.php
**/bootstrap/cache/*.php

# Keep directory placeholders if later added
!storage/logs/.gitignore
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!**/storage/logs/.gitignore
!**/storage/framework/cache/.gitignore
!**/storage/framework/sessions/.gitignore
!**/storage/framework/testing/.gitignore
!**/storage/framework/views/.gitignore
!bootstrap/cache/.gitignore
!**/bootstrap/cache/.gitignore

# -----------------------------------------------------------------------------
# Local databases / dumps / backups
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
database/*.sqlite
**/database/*.sqlite
*.sql
*.sql.gz
*.dump
*.bak
*.backup

# Keep Docker init SQL scripts tracked; ignore only DB dumps by default above.
!docker/mysql/init/*.sql
!**/docker/mysql/init/*.sql

# Hermes/manual backup snapshots - useful locally, noisy/dangerous in Git
_hermes_backup/
**/_hermes_backup/

# -----------------------------------------------------------------------------
# Docker/local runtime artifacts
# -----------------------------------------------------------------------------
.docker-data/
docker-data/
mysql-data/
redis-data/
*.pid
*.sock

# -----------------------------------------------------------------------------
# OS / editor / IDE files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Test / coverage / reports
# -----------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
.phpunit.cache/
reports/

# -----------------------------------------------------------------------------
# Misc local temp
# -----------------------------------------------------------------------------
.tmp/
tmp/
temp/
.cache/
**/.cache/
