APP_NAME="SIMPUS Frontend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=auth-db
DB_PORT=3306
DB_DATABASE=auth_db
DB_USERNAME=root
DB_PASSWORD=[REDACTED]

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

AUTH_SERVICE_URL=http://auth-nginx
MAHASISWA_SERVICE_URL=http://mahasiswa-nginx
PPL_SERVICE_URL=http://ppl-nginx
KLINIK_SERVICE_URL=http://klinik-nginx
BANK_SERVICE_URL=http://bank-nginx

# Server-side only. Jangan expose ke JavaScript/browser.
INTERNAL_API_TOKEN=[REDACTED]
