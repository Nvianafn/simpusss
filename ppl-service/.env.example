APP_NAME=ppl-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=ppl-db
DB_PORT=3306
DB_DATABASE=ppl_db
DB_USERNAME=root
DB_PASSWORD=secret

# Required for protected mutation endpoints. Use a long random value in non-dev environments.
INTERNAL_API_TOKEN=change-me-long-random-token

MAHASISWA_SERVICE_URL=http://mahasiswa-nginx
KLINIK_SERVICE_URL=http://klinik-nginx
BANK_SERVICE_URL=http://bank-nginx
